    id integer PRIMARY KEY, v int NOT NULL,
    body text GENERATED ALWAYS AS (generate_string(id, 6000)) STORED
) USING orioledb;
CREATE INDEX ON t_indep8_001 (v);
CREATE TABLE t_indep8_010 (
    id integer PRIMARY KEY, v int NOT NULL,
    body text GENERATED ALWAYS AS (generate_string(id, 6000)) STORED
) USING orioledb;
CREATE INDEX ON t_indep8_010 (v);
CREATE TABLE t_indep8_011 (
    id integer PRIMARY KEY, v int NOT NULL,
    body text GENERATED ALWAYS AS (generate_string(id, 6000)) STORED
) USING orioledb;
CREATE INDEX ON t_indep8_011 (v);
CREATE TABLE t_indep8_100 (
    id integer PRIMARY KEY, v int NOT NULL,
    body text GENERATED ALWAYS AS (generate_string(id, 6000)) STORED
) USING orioledb;
CREATE INDEX ON t_indep8_100 (v);
CREATE TABLE t_indep8_101 (
    id integer PRIMARY KEY, v int NOT NULL,
    body text GENERATED ALWAYS AS (generate_string(id, 6000)) STORED
) USING orioledb;
CREATE INDEX ON t_indep8_101 (v);
CREATE TABLE t_indep8_110 (
    id integer PRIMARY KEY, v int NOT NULL,
    body text GENERATED ALWAYS AS (generate_string(id, 6000)) STORED
) USING orioledb;
CREATE INDEX ON t_indep8_110 (v);
CREATE TABLE t_indep8_111 (
    id integer PRIMARY KEY, v int NOT NULL,
    body text GENERATED ALWAYS AS (generate_string(id, 6000)) STORED
) USING orioledb;
CREATE INDEX ON t_indep8_111 (v);
