-- Q) Bridge index + TOAST: a non-btree secondary index (BRIN) makes the
-- primary bridging, adding one to ctid_off in the multi-toast helper.
CREATE TABLE t_toast_bridge (
    id integer PRIMARY KEY,
    body text GENERATED ALWAYS AS (generate_string(id, 6000)) STORED
) USING orioledb;
CREATE INDEX ON t_toast_bridge USING brin(id);
NOTICE:  index bridging is enabled for orioledb table 't_toast_bridge'
DETAIL:  index access method 'brin' is supported only via index bridging for OrioleDB table
\set copyfile :abs_builddir '/results/toast_bridge.data'
