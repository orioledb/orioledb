(1 row)

SELECT id, length(body) FROM t_toast_unsorted
  WHERE id IN (1, 3, 5, 5555, 7777, 9999) ORDER BY id;
  id  | length 
------+--------
    1 |   6000
    3 |   6000
    5 |   6000
 5555 |   6000
 7777 |   6000
 9999 |   6000
(6 rows)

SELECT orioledb_tbl_check('t_toast_unsorted'::regclass);
 orioledb_tbl_check 
--------------------
