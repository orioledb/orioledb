-- AM) Multiple SK indexes (3+): each index gets its own aminsertmulti call.
CREATE TABLE t_multi_sk (
    id integer PRIMARY KEY,
    a  int NOT NULL,
    b  int NOT NULL,
    c  int NOT NULL
) USING orioledb;
CREATE INDEX t_multi_sk_a ON t_multi_sk (a);
CREATE INDEX t_multi_sk_b ON t_multi_sk (b);
CREATE INDEX t_multi_sk_c ON t_multi_sk (c);
\set copyfile :abs_builddir '/results/multi_sk.data'
COPY (SELECT i, i * 3, i * 7 % 500, i * 11 % 200 FROM generate_series(1, 3000) i) TO :'copyfile';
SET orioledb.debug_disable_multi_insert = false;
SET orioledb.debug_disable_sk_multi_insert = false;
COPY t_multi_sk FROM :'copyfile';
