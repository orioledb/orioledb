-- pk=off  toast=off  sk=on
SET orioledb.debug_disable_multi_insert = false;
SET orioledb.debug_disable_toast_multi_insert = false;
SET orioledb.debug_disable_sk_multi_insert = true;
COPY t_indep8_001 (id, v) FROM :'copyfile';
-- pk=off  toast=on  sk=off
SET orioledb.debug_disable_multi_insert = false;
SET orioledb.debug_disable_toast_multi_insert = true;
SET orioledb.debug_disable_sk_multi_insert = false;
COPY t_indep8_010 (id, v) FROM :'copyfile';
-- pk=off  toast=on  sk=on
SET orioledb.debug_disable_multi_insert = false;
SET orioledb.debug_disable_toast_multi_insert = true;
SET orioledb.debug_disable_sk_multi_insert = true;
COPY t_indep8_011 (id, v) FROM :'copyfile';
-- pk=on  toast=off  sk=off
SET orioledb.debug_disable_multi_insert = true;
SET orioledb.debug_disable_toast_multi_insert = false;
SET orioledb.debug_disable_sk_multi_insert = false;
COPY t_indep8_100 (id, v) FROM :'copyfile';
-- pk=on  toast=off  sk=on
SET orioledb.debug_disable_multi_insert = true;
SET orioledb.debug_disable_toast_multi_insert = false;
SET orioledb.debug_disable_sk_multi_insert = true;
COPY t_indep8_101 (id, v) FROM :'copyfile';
-- pk=on  toast=on  sk=off
SET orioledb.debug_disable_multi_insert = true;
SET orioledb.debug_disable_toast_multi_insert = true;
SET orioledb.debug_disable_sk_multi_insert = false;
COPY t_indep8_110 (id, v) FROM :'copyfile';
-- pk=on  toast=on  sk=on  (all per-row)
SET orioledb.debug_disable_multi_insert = true;
SET orioledb.debug_disable_toast_multi_insert = true;
SET orioledb.debug_disable_sk_multi_insert = true;
COPY t_indep8_111 (id, v) FROM :'copyfile';
SET orioledb.debug_disable_multi_insert = false;
