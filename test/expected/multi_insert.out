     = (SELECT count(*) FROM t_indep8_nt_000 WHERE a BETWEEN 100 AND 200) AS a101,
       (SELECT count(*) FROM t_indep8_nt_110 WHERE a BETWEEN 100 AND 200)
     = (SELECT count(*) FROM t_indep8_nt_000 WHERE a BETWEEN 100 AND 200) AS a110,
       (SELECT count(*) FROM t_indep8_nt_111 WHERE a BETWEEN 100 AND 200)
     = (SELECT count(*) FROM t_indep8_nt_000 WHERE a BETWEEN 100 AND 200) AS a111;
 ref_a | a001 | a010 | a011 | a100 | a101 | a110 | a111 
-------+------+------+------+------+------+------+------
   404 | t    | t    | t    | t    | t    | t    | t
(1 row)

SELECT (SELECT count(*) FROM t_indep8_nt_000 WHERE b BETWEEN 50 AND 150 AND c < 100) AS ref_bc,
       (SELECT count(*) FROM t_indep8_nt_001 WHERE b BETWEEN 50 AND 150 AND c < 100)
     = (SELECT count(*) FROM t_indep8_nt_000 WHERE b BETWEEN 50 AND 150 AND c < 100) AS bc001,
