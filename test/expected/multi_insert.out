CREATE TABLE t_sk_par_a (
    id integer PRIMARY KEY,
    v  int NOT NULL
) USING orioledb;
CREATE INDEX ON t_sk_par_a (v);
CREATE TABLE t_sk_par_b (
    id integer PRIMARY KEY,
    v  int NOT NULL
) USING orioledb;
CREATE INDEX ON t_sk_par_b (v);
