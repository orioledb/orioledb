-- AC) CTID-PK + SK + TOAST: exercises all three multi-insert paths
-- together on a table with no explicit PK.
CREATE TABLE t_ctid_sk_toast (
    v    int NOT NULL,
    body text GENERATED ALWAYS AS (generate_string(v, 6000)) STORED
) USING orioledb;
CREATE INDEX t_ctid_sk_toast_v_idx ON t_ctid_sk_toast (v);
\set copyfile :abs_builddir '/results/ctid_sk_toast.data'
COPY (SELECT i FROM generate_series(1, 500) i) TO :'copyfile';
SET orioledb.debug_disable_multi_insert = false;
SET orioledb.debug_disable_sk_multi_insert = false;
COPY t_ctid_sk_toast (v) FROM :'copyfile';
SELECT count(*) FROM t_ctid_sk_toast;
 count 
-------
   500
(1 row)

SELECT count(*) FROM t_ctid_sk_toast WHERE v BETWEEN 100 AND 200;
 count 
-------
   101
(1 row)

SELECT count(*) FROM t_ctid_sk_toast WHERE length(body) = 6000;
 count 
-------
   500
(1 row)

SELECT orioledb_tbl_check('t_ctid_sk_toast'::regclass);
 orioledb_tbl_check 
--------------------
 t
(1 row)

