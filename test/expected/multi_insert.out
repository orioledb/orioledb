-- AJ) Batchable + non-batchable indexes on the same table: one normal SK
-- plus one partial SK.  CopyTryMultiInsertIndexes returns false for all
-- indexes, so even the normal SK goes per-tuple via ExecInsertIndexTuples.
CREATE TABLE t_mixed_idx (
    id integer PRIMARY KEY,
    a  int NOT NULL,
    b  int NOT NULL
) USING orioledb;
CREATE INDEX t_mixed_idx_a ON t_mixed_idx (a);
CREATE INDEX t_mixed_idx_b ON t_mixed_idx (b) WHERE b > 500;
\set copyfile :abs_builddir '/results/mixed_idx.data'
COPY (SELECT i, i * 3, i * 7 % 1000 FROM generate_series(1, 2000) i) TO :'copyfile';
SET orioledb.debug_disable_multi_insert = false;
COPY t_mixed_idx FROM :'copyfile';
SELECT count(*) FROM t_mixed_idx;
 count 
-------
  2000
(1 row)

SET enable_seqscan = off;
SELECT count(*) FROM t_mixed_idx WHERE a BETWEEN 300 AND 600;
 count 
-------
   101
(1 row)

SELECT count(*) FROM t_mixed_idx WHERE b > 500 AND b < 800;
 count 
-------
   598
(1 row)

SET enable_seqscan = on;
SELECT orioledb_tbl_check('t_mixed_idx'::regclass);
