       (SELECT count(*) FROM t_indep8_nt_101 WHERE b BETWEEN 50 AND 150 AND c < 100)
     = (SELECT count(*) FROM t_indep8_nt_000 WHERE b BETWEEN 50 AND 150 AND c < 100) AS bc101,
       (SELECT count(*) FROM t_indep8_nt_110 WHERE b BETWEEN 50 AND 150 AND c < 100)
     = (SELECT count(*) FROM t_indep8_nt_000 WHERE b BETWEEN 50 AND 150 AND c < 100) AS bc110,
       (SELECT count(*) FROM t_indep8_nt_111 WHERE b BETWEEN 50 AND 150 AND c < 100)
     = (SELECT count(*) FROM t_indep8_nt_000 WHERE b BETWEEN 50 AND 150 AND c < 100) AS bc111;
