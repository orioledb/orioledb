-- AE) Partial (WHERE) index: CopyTryMultiInsertIndexes returns false
-- because ii_Predicate != NIL, so COPY falls back to per-tuple insertion.
CREATE TABLE t_partial (
    id integer PRIMARY KEY,
    v  int NOT NULL
) USING orioledb;
CREATE INDEX t_partial_v_idx ON t_partial (v) WHERE v > 100;
\set copyfile :abs_builddir '/results/partial.data'
COPY (SELECT i, i * 3 FROM generate_series(1, 2000) i) TO :'copyfile';
SET orioledb.debug_disable_multi_insert = false;
COPY t_partial FROM :'copyfile';
SELECT count(*) FROM t_partial;
 count 
-------
  2000
(1 row)

SET enable_seqscan = off;
SELECT count(*) FROM t_partial WHERE v > 100 AND v < 1000;
 count 
-------
   300
(1 row)

SET enable_seqscan = on;
SELECT orioledb_tbl_check('t_partial'::regclass);
 orioledb_tbl_check 
--------------------
 t
(1 row)

-- AF) Deferred unique SK: CopyTryMultiInsertIndexes returns false because
-- indisunique && !indimmediate.
