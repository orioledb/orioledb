-- AN) Dense duplicate SK values: many rows sharing the same SK key value
-- hammer the same SK leaf, stressing page splits in the SK tree.
CREATE TABLE t_dense_sk (
    id integer PRIMARY KEY,
    grp int NOT NULL
) USING orioledb;
CREATE INDEX t_dense_sk_grp ON t_dense_sk (grp);
