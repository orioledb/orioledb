step s2_count_ordered: 
	SELECT count(*), min(b), max(b),
		(count(*) = count(*) FILTER (WHERE prev IS NULL OR b > prev)) AS sorted
	FROM (SELECT b, lag(b) OVER () AS prev FROM (
		SELECT b FROM o_pis_disk
			WHERE a = 5 AND sqrt(v::float8) >= 0
			ORDER BY b) o) t;
