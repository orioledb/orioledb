DELETE FROM o_test_include_pk WHERE id = 'c';
SET enable_seqscan = off;
SELECT id, grp FROM o_test_include_pk
	WHERE NOT deleted AND ttl IS NOT NULL ORDER BY grp, created_at, id;
 id | grp 
----+-----
 b  | g-0
