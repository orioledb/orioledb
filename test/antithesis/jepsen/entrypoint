#!/bin/sh
set -eu

if [ "${JEPSEN_MODE:-}" = initialize ]; then
	case "${JEPSEN_INITIALIZER:-checkpoint-recovery}" in
	checkpoint-recovery)
		namespace=jepsen.orioledb.workload.checkpoint-recovery
		;;
	row-locks)
		namespace=jepsen.orioledb.workload.row-locks
		;;
	*)
		echo "unknown JEPSEN_INITIALIZER=${JEPSEN_INITIALIZER}" >&2
		exit 2
		;;
	esac
	exec java -ea -cp '/opt/jepsen/*' -Djava.awt.headless=true clojure.main \
		-m "$namespace" initialize
fi

# Under Antithesis, sleep indefinitely: Antithesis runs the test template scripts.
if [ -n "${ANTITHESIS_OUTPUT_DIR:-}" ]; then
	exec sleep infinity
fi

# Outside antithesis, simulate test-driver actions
cd "/opt/antithesis/test/v1/${JEPSEN_TEST_SUITE:-jepsen-postgres}"

rc=0
for command in first_* singleton_driver_* eventually_* finally_*; do
	[ -x "$command" ] || continue
	./"$command" "$@" || rc=$?
done
exit "$rc"
